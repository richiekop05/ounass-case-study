# Copy to .env and fill in: cp .env.example .env
# .env is gitignored. Never commit real values.

# Database connection, used by every command and both apps.
# Supabase dashboard: Connect button -> Session pooler -> connection string (URI), with your database password.
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your-password@aws-0-region.pooler.supabase.com:5432/postgres

# Photo storage (upload when scraping, signed links in the apps).
# Supabase dashboard: Project Settings -> Data API -> Project URL.
SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase dashboard: Project Settings -> API Keys -> secret key (or the legacy service_role key). Keep it private.
SUPABASE_SERVICE_KEY=your-service-role-key

# Sent with every request to ounass.ae so the site can see who is scraping. Put a real contact address in it.
SCRAPER_USER_AGENT=OunassCaseStudyScraper/0.1 (case-study prototype; contact: you@example.com)

# Anthropic API key for the tagging models: console.anthropic.com -> API keys.
# Or run `uv run tagger models set-key ANTHROPIC_API_KEY`, which stores it here without showing it.
ANTHROPIC_API_KEY=
